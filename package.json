{
  "name": "dayboard",
  "version": "0.0.0",
  "description": "A calm new tab board of clocks, countdowns, notes, timers, quotes, and habits.",
  "author": "Dayboard contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:edge": "node scripts/dev.ts edge",
    "build": "vite build",
    "build:edge": "vite build --outDir .output/edge-mv3",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:fast": "npm run format:check && npm run typecheck && npm run test",
    "check": "npm run check:fast && npm run test:e2e",
    "zip": "npm run build && cd .output/chrome-mv3 && zip -qrD -FS ../dayboard-chrome.zip .",
    "zip:edge": "npm run build:edge && cd .output/edge-mv3 && zip -qrD -FS ../dayboard-edge.zip ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
