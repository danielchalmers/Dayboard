{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.exclude": {
    "node_modules": true,
    "dist": true,
    ".output": true,
    ".vscode/chrome-debug-profile": true,
    ".vscode/edge-debug-profile": true
  },
  "files.associations": {
    "*.json": "jsonc"
  }
}
